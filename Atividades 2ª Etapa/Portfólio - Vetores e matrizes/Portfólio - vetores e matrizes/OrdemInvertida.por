programa
{
    funcao inicio()
    {
        inteiro vetor[6]

        vetor[0] = 0

        para (inteiro i = 1; i <= 5; i++)
        {
            escreva("Digite um número: ")
            leia(vetor[i])
        }

        escreva(vetor[4])
    }
}
